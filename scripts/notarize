#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
profile=${SYNAPS_NOTARY_PROFILE:-synaps}
archive="$root/dist/synaps.zip"
application="$root/dist/synaps.app"
stage=$(mktemp -d "${TMPDIR:-/tmp}/synapsnotary.XXXXXX")
trap 'rm -rf "$stage"' EXIT INT TERM

if [ -n "${APPLE_ID:-}${APPLE_TEAM_ID:-}${APPLE_APP_PASSWORD:-}" ]; then
    : "${APPLE_ID:?APPLE_ID is required}"
    : "${APPLE_TEAM_ID:?APPLE_TEAM_ID is required}"
    : "${APPLE_APP_PASSWORD:?APPLE_APP_PASSWORD is required}"
    xcrun notarytool submit "$archive" \
        --apple-id "$APPLE_ID" \
        --team-id "$APPLE_TEAM_ID" \
        --password "$APPLE_APP_PASSWORD" \
        --wait
else
    xcrun notarytool submit "$archive" --keychain-profile "$profile" --wait
fi
xcrun stapler staple "$application"
xcrun stapler validate "$application"
spctl --assess --type execute --verbose=2 "$application"
ditto -c -k --norsrc --noextattr --noqtn --noacl --keepParent "$application" "$stage/synaps.zip"
mv "$stage/synaps.zip" "$archive"
